{
  "name": "picasso-studio",
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.runtime.json && vite build && vite build --config vite.runtime.config.ts && node scripts/prepare-runtime.mjs",
    "test": "vitest run",
    "prepack": "npm run build",
    "test:unit": "vitest run test/protocol.test.ts test/store.test.ts test/controller.test.ts test/preview.test.tsx",
    "test:browser": "vitest run test/browser.test.ts",
    "test:ci": "vitest run --exclude test/harness-config.test.ts"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/node": "26.6.6",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "jsonc-parser": "3.3.1",
    "playwright-core": "1.65.0",
    "react": "latest",
    "react-dom": "latest",
    "toml-eslint-parser": "1.0.3",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest",
    "zod": "4.6.7"
  },
  "description": "Local visual design collaboration for coding agents",
  "bin": {
    "picasso-studio": "dist-runtime/cli.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "dist-runtime",
    "README.md",
    "docs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mehdishahdoost/picasso-studio.git"
  },
  "homepage": "https://github.com/mehdishahdoost/picasso-studio#readme",
  "bugs": {
    "url": "https://github.com/mehdishahdoost/picasso-studio/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
